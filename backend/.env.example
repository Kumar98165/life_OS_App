# Flask Environment Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-jwt-secret

# Token Lifespans
JWT_ACCESS_TOKEN_EXPIRES_SEC=3600
JWT_REFRESH_TOKEN_EXPIRES_SEC=2592000

# PostgreSQL Connection (Host, Port, User, Password, DB)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/lifeos_db
TEST_DATABASE_URL=sqlite:///:memory:

# Local AI Engine Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
